      "Bash(del:*)",
      "Bash(Remove-Item:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(Invoke-RestMethod:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(vercel:*)",
      "Bash(ssh:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*credential*)",
      "Read(./**/*secret*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./seguridad/**)",
      "Write(./seguridad/**)",
      "Edit(./CONSTITUCION.md)",
      "WebFetch",
      "WebSearch"
