# Quadro Sites — Variables de entorno (plantilla sin valores reales)
# Copiar a .env.local en desarrollo o configurar en Vercel (Production / Preview).
# NUNCA commitear valores reales en git.

# Backend de almacenamiento: 'file' (local/tests) | 'cloud' (Vercel + Supabase)
STORAGE_BACKEND=

# Supabase (requeridas cuando STORAGE_BACKEND=cloud)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Opcional: mapa JSON de hashes SHA-256 por artista (fallback/override en modo cloud)
# Formato: {"luna-vega":"<sha256-hex>"}
ARTIST_TOKEN_HASHES=

# Proveedor de IA: 'mock' (dev/tests) | 'anthropic' (producción)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_PER_ARTIST=

# Configuración pública del sitio
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Opcional: host de CDN adicional permitido en next/image y validación de medios
NEXT_PUBLIC_MEDIA_HOST=
